{
  "name": "chaya-ui",
  "version": "1.0.0-beta.90",
  "description": "Modern, Data-First UI Components for React",
  "scripts": {
    "tailwind": "tailwindcss -i ./src/style.scss -o ./dist/style.css -c ./tailwind.config.cjs",
    "build-components": "rm -rf dist && rollup -c",
    "build-tailwind": "npm run tailwind -- --minify",
    "build": "npm run build-components",
    "lint": "eslint src/",
    "lint-fix": "eslint --fix src/",
    "watch-tailwind": "npm run tailwind -- --watch",
    "dev": "concurrently \"npm run watch-tailwind\" \"storybook dev -p 6006\"",
    "build-storybook": "npm run build-tailwind && storybook build",
    "type-check": "tsc --noEmit --emitDeclarationOnly false",
    "storybook": "storybook dev -p 6006",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "prepare": "husky"
  },
  "contributors": [
    "Ashwin S Shenoy <aswinshenoy65@gmail.com>",
    "Advaith A J <advaitharunjeena@gmail.com>",
    "Abhiram Krishna <abhikrishnaram88@gmail.com>"
  ],
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/chaya-ui/chaya-ui/issues"
  },
  "homepage": "https://github.com/chaya-ui/chaya-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaya-ui/chaya-ui.git"
  },
  "keywords": [
    "react",
    "react-components",
    "uikit",
    "accessible",
    "components",
    "library",
    "design-system",
    "chaya-ui"
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/papaparse": "^5.5.2",
    "clsx": "^2.1.1",
    "color": "^5.0.3",
    "cva": "^1.0.0-beta.1",
    "date-fns": "^4.4.0",
    "flatten-anything": "^4.0.2",
    "nanoid": "^5.0.3",
    "papaparse": "^5.5.4",
    "react-waypoint": "^10.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.22.5",
    "@babel/preset-react": "^7.22.5",
    "@babel/preset-typescript": "^7.22.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/webappsec-credential-management": "^0.6.9",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^8.3.0",
    "concurrently": "^10.0.4",
    "css-loader": "^6.7.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.5.7",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.4.21",
    "postcss-nesting": "^12.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^3.10.0",
    "rollup-plugin-dts": "^5.1.1",
    "rollup-plugin-polyfill-node": "^0.11.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-preserve-directives": "^0.2.0",
    "sass": "^1.57.1",
    "sass-loader": "^13.2.0",
    "storybook": "^10.5.7",
    "style-loader": "^3.3.1",
    "tailwindcss": "^3.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.4.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "files": [
    "dist"
  ],
  "module": "dist/src/index.js",
  "types": "dist/types/index.d.ts",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
